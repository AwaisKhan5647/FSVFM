__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.env
*.log

# Model checkpoints — large binary files
*.pth
*.pt
*.ckpt

# Experiment runtime outputs
experiments/dry_run_*/
experiments/*/log_detail.txt
experiments/*/progress_watcher.log
logs/

# Large inference CSVs and per-dataset result CSVs (derived, reproducible)
experiments/*/inference_*/inference_results.csv
experiments/*/inference_*/video_results.csv
experiments/*/inference_*/**/*.csv
experiments/*/inference_*/*.csv
*.txt.bak
/tmp/rewind_*.txt
/tmp/dfdc_*.txt

# Keep human-readable results and configs
!experiments/*/result.txt
!experiments/*/progress.txt
!experiments/*/config.json
!experiments/*/train_log.txt
!experiments/*/watchdog.log
!experiments/*/inference_*/inference_summary.txt
.result_written

# experiment_image runtime outputs
experiment_image/runs/*/log_detail.txt
experiment_image/runs/*/progress_watcher.log
experiment_image/runs/*/watchdog_stdout.log
experiment_image/runs/*/train_stdout.log
experiment_image/runs/*/eval_*/eval.log
experiment_image/runs/*/eval_*/inference_results.csv
experiment_image/runs/*/eval_*/video_results.csv
experiment_image/runs/__pycache__/
experiment_image/__pycache__/
experiment_image/augmentations/__pycache__/
experiment_image/pipeline_state.env
experiment_image/runs/dry_run_*/
experiment_image/runs/*/.step_*.done
experiment_image/runs/*/events.out.tfevents.*
.claude/

# Keep human-readable experiment_image outputs
!experiment_image/runs/*/result.txt
!experiment_image/runs/*/progress.txt
!experiment_image/runs/*/pipeline_progress.txt
!experiment_image/runs/*/pipeline.log
!experiment_image/runs/*/config.json
!experiment_image/runs/*/train_log.txt
!experiment_image/runs/*/watchdog.log
!experiment_image/runs/*/augment_config_used.json
!experiment_image/runs/*/results_summary.txt
!experiment_image/runs/*/eval_*/inference_summary.txt

# experiment_image_kutub runtime outputs
experiment_image_kutub/runs/*/log_detail.txt
experiment_image_kutub/runs/*/train_stdout.log
experiment_image_kutub/runs/*/events.out.tfevents.*
experiment_image_kutub/runs/dry_run_*/
experiment_image_kutub/__pycache__/
experiment_image_kutub/pipeline_state_variant_*.env

# Keep human-readable experiment_image_kutub outputs
!experiment_image_kutub/runs/*/result.txt
!experiment_image_kutub/runs/*/progress.txt
!experiment_image_kutub/runs/*/pipeline.log
!experiment_image_kutub/runs/*/pipeline_progress.txt
!experiment_image_kutub/runs/*/config.json
!experiment_image_kutub/runs/*/train_log.txt
!experiment_image_kutub/runs/*/augment_config_used.json
